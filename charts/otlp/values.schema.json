{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["otlp", "securityProfile", "delivery", "networkPolicy", "resources", "image"],
  "properties": {
    "otlp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "baseEndpoint", "headerName", "headerPrefix", "tokenSecret", "tokenKey", "additionalHeaders", "compression", "signals", "tls"],
      "properties": {
        "endpoint": {"type": "string", "format": "uri", "minLength": 1},
        "baseEndpoint": {"type": "string"},
        "headerName": {"type": "string", "minLength": 1},
        "headerPrefix": {"type": "string"},
        "tokenSecret": {"type": "string", "minLength": 1},
        "tokenKey": {"type": "string", "minLength": 1},
        "additionalHeaders": {"type": "object", "additionalProperties": {"type": "string"}},
        "compression": {"type": "string", "enum": ["gzip", "none"]},
        "signals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logs", "traces", "metrics"],
          "anyOf": [
            {"properties": {"logs": {"const": true}}},
            {"properties": {"traces": {"const": true}}},
            {"properties": {"metrics": {"const": true}}}
          ],
          "properties": {
            "logs": {"type": "boolean"},
            "traces": {"type": "boolean"},
            "metrics": {"type": "boolean"}
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["insecureSkipVerify", "caSecret", "caKey", "clientSecret", "certKey", "keyKey"],
          "properties": {
            "insecureSkipVerify": {"type": "boolean"},
            "caSecret": {"type": "string"},
            "caKey": {"type": "string", "minLength": 1},
            "clientSecret": {"type": "string"},
            "certKey": {"type": "string", "minLength": 1},
            "keyKey": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "securityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "includeFullPayload"],
      "properties": {
        "enabled": {"type": "boolean"},
        "includeFullPayload": {"type": "boolean"}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queueSize", "retryMaxElapsedTime", "persistence"],
      "properties": {
        "queueSize": {"type": "integer", "minimum": 1},
        "retryMaxElapsedTime": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "size"],
          "properties": {
            "enabled": {"type": "boolean"},
            "size": {"type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allowedNamespaces"],
      "properties": {
        "enabled": {"type": "boolean"},
        "allowedNamespaces": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "resources": {"type": "object"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["otelCollector"],
      "properties": {"otelCollector": {"type": "string", "minLength": 1}}
    }
  }
}
