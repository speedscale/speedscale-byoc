{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "newrelic", "resources", "delivery", "networkPolicy"],
  "properties": {
    "image": {"type": "string", "minLength": 1},
    "newrelic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "credentialsSecret", "licenseKeyField"],
      "properties": {
        "endpoint": {"type": "string", "format": "uri", "minLength": 1},
        "credentialsSecret": {"type": "string", "minLength": 1},
        "licenseKeyField": {"type": "string", "minLength": 1}
      }
    },
    "resources": {"type": "object"},
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queueSize", "retryMaxElapsedTime"],
      "properties": {
        "queueSize": {"type": "integer", "minimum": 1},
        "retryMaxElapsedTime": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allowedNamespaces"],
      "properties": {
        "enabled": {"type": "boolean"},
        "allowedNamespaces": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
