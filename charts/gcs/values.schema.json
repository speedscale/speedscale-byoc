{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["gcs", "serviceAccount", "auth", "resources", "delivery", "networkPolicy", "reader", "image"],
  "definitions": {
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "secretName", "configMapName", "audience"],
      "properties": {
        "mode": {"enum": ["ambient", "secret", "federation"]},
        "secretName": {"type": "string"},
        "configMapName": {"type": "string"},
        "audience": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "secret"}}},
          "then": {"properties": {"secretName": {"minLength": 1}}}
        },
        {
          "if": {"properties": {"mode": {"const": "federation"}}},
          "then": {"properties": {"configMapName": {"minLength": 1}, "audience": {"minLength": 1}}}
        }
      ]
    }
  },
  "properties": {
    "image": {"type": "string", "minLength": 1},
    "gcs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "bucket", "region", "prefix"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "bucket": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._-]+[a-z0-9]$"
        },
        "region": {"type": "string", "minLength": 1},
        "prefix": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "auth": {"$ref": "#/definitions/auth"},
    "resources": {"type": "object"},
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queueSize", "persistence"],
      "properties": {
        "queueSize": {"type": "integer", "minimum": 1},
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "size"],
          "properties": {
            "enabled": {"type": "boolean"},
            "size": {"type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allowedNamespaces"],
      "properties": {
        "enabled": {"type": "boolean"},
        "allowedNamespaces": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "reader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "auth", "serviceAccount", "resources", "rbac"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string"},
        "auth": {"$ref": "#/definitions/auth"},
        "resources": {"type": "object"},
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["create", "name", "annotations"],
          "properties": {
            "create": {"type": "boolean"},
            "name": {"type": "string"},
            "annotations": {
              "type": "object",
              "additionalProperties": {"type": "string"}
            }
          }
        },
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "required": ["create", "subjects"],
          "properties": {
            "create": {"type": "boolean"},
            "subjects": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "name"],
                "properties": {
                  "kind": {"enum": ["User", "Group", "ServiceAccount"]},
                  "name": {"type": "string", "minLength": 1},
                  "namespace": {"type": "string"},
                  "apiGroup": {"type": "string"}
                }
              }
            }
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"enabled": {"const": true}}},
        "then": {"properties": {"image": {"minLength": 1}}}
      }]
    }
  }
}
