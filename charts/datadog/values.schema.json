{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "datadog", "resources"],
  "properties": {
    "image": {"type": "string", "minLength": 1},
    "datadog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "credentialsSecret", "apiKeyField"],
      "properties": {
        "site": {"type": "string", "minLength": 1},
        "credentialsSecret": {"type": "string", "minLength": 1},
        "apiKeyField": {"type": "string", "minLength": 1}
      }
    },
    "resources": {"type": "object"}
  }
}
