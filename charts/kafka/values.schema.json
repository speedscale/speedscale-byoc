{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["kafka", "securityProfile", "delivery", "networkPolicy", "resources", "image"],
  "properties": {
    "kafka": {
      "type": "object",
      "required": ["brokers", "topic", "encoding", "tls"],
      "properties": {
        "brokers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "topic": {"type": "string", "minLength": 1},
        "encoding": {"type": "string", "enum": ["otlp_json", "otlp_proto"]},
        "tls": {
          "type": "object",
          "required": ["enabled", "insecureSkipVerify", "caSecret", "caKey"],
          "properties": {
            "enabled": {"type": "boolean"},
            "insecureSkipVerify": {"type": "boolean"},
            "caSecret": {"type": "string"},
            "caKey": {"type": "string"}
          }
        }
      }
    },
    "securityProfile": {
      "type": "object",
      "required": ["includeFullPayload"],
      "properties": {"includeFullPayload": {"type": "boolean"}}
    },
    "delivery": {
      "type": "object",
      "required": ["queueSize", "persistence"],
      "properties": {
        "queueSize": {"type": "integer", "minimum": 1},
        "persistence": {
          "type": "object",
          "required": ["enabled", "size"],
          "properties": {
            "enabled": {"type": "boolean"},
            "size": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "allowedNamespaces"],
      "properties": {
        "enabled": {"type": "boolean"},
        "allowedNamespaces": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "resources": {"type": "object"},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {"type": "string"},
        "tag": {"type": "string"},
        "digest": {"type": "string"}
      }
    }
  }
}
